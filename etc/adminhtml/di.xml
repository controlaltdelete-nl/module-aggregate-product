            <argument name="modifiers" xsi:type="array">
                <item name="aggregateWeight" xsi:type="string">Nfourteen\AggregateProduct\Ui\DataProvider\Product\Form\Modifier\AggregateWeight</item>
                <item name="aggregatePanel" xsi:type="string">Nfourteen\AggregateProduct\Ui\DataProvider\Product\Form\Modifier\AggregatePanel</item>
                <item name="aggregateModal" xsi:type="string">Nfourteen\AggregateProduct\Ui\DataProvider\Product\Form\Modifier\AggregateModal</item>
                <item name="aggregateProductsListing" xsi:type="string">Nfourteen\AggregateProduct\Ui\DataProvider\Product\Form\Modifier\AggregateProductsListing</item>
            </argument>
        </arguments>
